{
  "expo": {
    "name": "ZillyBuy",
    "slug": "zillybuy-app",
    "version": "4.0.2",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "zillybuy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/AppIcon.icon",
      "bundleIdentifier": "com.zillybuy.app",
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "upi",
          "phonepe",
          "paytmmp",
          "tez",
          "gpay",
          "credpay",
          "bhim"
        ]
      }
    },
    "android": {
      "package": "com.zillybuy",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/splash-blank.png",
          "imageWidth": 1,
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/brand/splash-blank.png"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ZillyBuy needs access to your photos so you can add them to product reviews or search with a picture.",
          "cameraPermission": "ZillyBuy uses the camera so you can photograph a product and ask ZillyAI to find it.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#0066CC",
          "defaultChannel": "default"
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "ZillyBuy uses the microphone so you can ask ZillyAI questions by voice."
        }
      ],
      "expo-asset",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64f69188-63f5-4bd6-8783-9a91e9eb5d29"
      }
    },
    "owner": "shaikh_akbar"
  }
}
